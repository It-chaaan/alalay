# Public values are embedded during Expo bundling. Set them before every APK build.
EXPO_PUBLIC_API_URL=
# Supabase project URL, for example https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Supabase anon or publishable key only. Never use a service-role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
