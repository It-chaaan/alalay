{
  "expo": {
    "name": "Alalay",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "alalay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/alalay-app-icon.png",
    "splash": {
      "image": "./assets/alalay-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "icon": "./assets/alalay-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/alalay-adaptive-foreground.png",
        "backgroundColor": "#D8EFE2"
      },
      "package": "com.anonymous.mobile"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/alalay-notification-icon.png",
          "color": "#0F6F57"
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Budget Tracker to use your camera to scan receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Budget Tracker to choose receipt photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "011fbb98-b405-4761-9aa7-e81a9b06d011"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/011fbb98-b405-4761-9aa7-e81a9b06d011"
    }
  }
}
